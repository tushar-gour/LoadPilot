{
  "name": "loadpilot",
  "version": "0.2.0",
  "description": "Composable HTTP(S) load balancer and reverse proxy for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "test": "tsx --test tests/test.ts tests/proxy.test.ts tests/health.test.ts tests/metrics.test.ts tests/reliability.test.ts tests/memory-reliability.test.ts tests/lifecycle.test.ts tests/tls.test.ts tests/proxy-security.test.ts tests/algorithms.test.ts tests/architecture.test.ts tests/custom-algorithms.test.ts tests/health-policy.test.ts",
    "typecheck": "tsc -p tsconfig.bench.json",
    "prepack": "npm run build",
    "bench": "tsx benchmarks/run.ts bench",
    "bench:algorithms": "tsx benchmarks/algorithms.ts",
    "bench:full": "tsx benchmarks/run.ts bench --full",
    "bench:stream": "tsx benchmarks/run.ts stream",
    "fault": "tsx benchmarks/run.ts fault",
    "soak": "tsx benchmarks/run.ts soak",
    "bench:memory": "tsx benchmarks/investigate.ts memory",
    "bench:capacity": "tsx benchmarks/investigate.ts capacity",
    "bench:soak": "tsx benchmarks/investigate.ts soak",
    "check:package": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --types node tests/package-consumer.mts && tsx tests/package-consumer.mts",
    "bench:compare-algorithms": "node benchmarks/compare-algorithms.mjs"
  },
  "keywords": [
    "load-balancer",
    "reverse-proxy",
    "http",
    "https",
    "round-robin",
    "health-check",
    "least-connections"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tushar-gour/LoadPilot.git"
  },
  "homepage": "https://github.com/tushar-gour/LoadPilot#readme",
  "bugs": {
    "url": "https://github.com/tushar-gour/LoadPilot/issues"
  }
}
